        advance: seconds => { for (let n = 0; n < Math.ceil(clamp(seconds, 0, 120) / AR.FIXED_DT); n++) this.tick(AR.FIXED_DT); return this.inspect(); }
      };
    }
  }
  AR.Versus = Versus; AR.VERSUS_ITEMS = ITEMS;
})();

