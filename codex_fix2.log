codex
Crisp now uses a fixed 2× backing buffer on Retina displays, and Performance is an explicit saved choice. I’ve replaced the per-frame seabed fill path and background decoration drawing with chunk caches. The new gameplay rules are also implemented; their regression tests are in progress while I finish the explosion visuals and rendering checks.
exec
/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
p=Path('docs/render.js'); s=p.read_text()
s=s.replace('    pickups(c, pickups) {', '    pickups(c, pickups, texturePass = false) {')
s=s.replace(\"        if (item.collected || "'!this.inView(item.x, item.y, 35)) continue;", "        if (item.collected || (!texturePass && !this.inView(item.x, item.y, 48))) continue;'"\\n        if ("'!texturePass) {'"\\n          const sprite = this.sprite('pickup:' + item.type, 112, 112, paint => {\\n            paint.translate(56, 56); const time = this.time; this.time = 0;\\n            this.pickups(paint, [{ ...item, x: 0, y: 0 }], true); this.time = time;\\n          });\\n          const bob = item.type === 'chest' ? 0 : Math.sin(this.time * 2.7 + item.x * .017) * 3;\\n          c.save(); c.translate(item.x, item.y + bob);\\n          if (item.type === 'crate') { const pulse = 1 + Math.sin(this.time * 3 + item.x) * .07; c.scale(pulse, pulse); }\\n          c.drawImage(sprite, -56, -56, 112, 112); c.restore(); continue;\\n        }\")
# Wheel geometry is rigid; cache the treads/spokes, rotate only the sprite.
s=s.replace('    wheel(c, wheel, id) {', '''    wheel(c, wheel, id, texturePass = false) {
      if ("'!texturePass) {
        const size = Math.ceil(wheel.radius + 4) * 2;
        const sprite = this.sprite('"'wheel:' + id + ':' + wheel.radius, size, size, paint => this.wheel(paint, { ...wheel, x: size / 2, y: size / 2, angle: 0 }, id, true));
        c.save(); c.translate(wheel.x, wheel.y); c.rotate(wheel.angle); c.drawImage(sprite, -size / 2, -size / 2, size, size); c.restore(); return;
      }''')
# Cache awareness labels as small sharp sprites (position/gap text still updates).
s=s.replace(\"          c.fillStyle = '#0a2632'; roundRect(c, x - 17, yy - 10, 34, 20, 8); c.fill();\\n          c.strokeStyle = color; c.lineWidth = 1; c.stroke(); c.fillStyle = color; c.fillText('P' + (player.index + 1), x, yy);\", \"          const label = this.sprite('player-label:' + player.index, 36, 22, paint => {\\n            paint.fillStyle = '#0a2632'; roundRect(paint, 1, 1, 34, 20, 8); paint.fill();\\n            paint.strokeStyle = color; paint.lineWidth = 1; paint.stroke(); paint.fillStyle = color; paint.font = '800 11px system-ui, sans-serif'; paint.textAlign = 'center'; paint.textBaseline = 'middle'; paint.fillText('P' + (player.index + 1), 18, 11);\\n          }, this.nativeDpr);\\n          c.drawImage(label, Math.round(x - 18), Math.round(yy - 11), 36, 22);\")
# Tighten background fish culling.
s=s.replace('          const size = 2.7 + hash(j + 51) * 2.2;', '          if (x < -20 || x > w + 20 || y < -20 || y > h + 20) continue;\\n          const size = 2.7 + hash(j + 51) * 2.2;')
p.write_text(s)
