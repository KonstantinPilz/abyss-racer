/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
p=Path('docs/render.js'); s=p.read_text()
needle=\"  const freezeSprite = canvas => canvas.transferToImageBitmap ? canvas.transferToImageBitmap() : canvas;\"
s=s.replace(needle,needle+'''
  const releaseSprite = value => { const sprite = value.sprite || value; if (sprite.close) sprite.close(); };
  function cacheSprite(cache, key, value, limit) {
    cache.set(key, value);
    if (cache.size > limit) { const oldest = cache.keys().next().value; releaseSprite(cache.get(oldest)); cache.delete(oldest); }
  }
  function clearSprites(cache) { for (const value of cache.values()) releaseSprite(value); cache.clear(); }
''')
import re
for name,limit in [('spriteCache',96),('vignetteCache',8),('backdropCache',8),('decorationCache',128),('decorationChunks',24),('groundCache',32),('chassisCache',32)]:
 s=s.replace(f'this.{name}.set(key, sprite);', f'cacheSprite(this.{name}, key, sprite, {limit});')
 s=s.replace(f'this.{name}.set(key, tile);', f'cacheSprite(this.{name}, key, tile, {limit});')
 s=re.sub(r'\\n +if \\(this\\.'+name+r'\\.size > \\d+\\) this\\.'+name+r'\\.delete\\(this\\.'+name+r'\\.keys\\(\\)\\.next\\(\\)\\.value\\);','',s)
 s=s.replace(f'this.{name}.clear()', f'clearSprites(this.{name})')
p.write_text(s)
